# Copy to tests/data.env (ignored by git) and point at the reference data.
RIG_INPUT_HOST=/path/to/rig-engine-test/input
RIG_NATIVE_HOST=/path/to/rig-native-results
RIG_FINAL_HOST=/path/to/rig-final-results
# Optional: a folder that already holds the pinned code archives (else they are fetched to dist/downloads).
# RIG_DOWNLOADS_HOST=/path/to/downloads
# test-mac.sh only (a Mac with Apple silicon): a built Mac root, SkinTokens' weights folder, and
# optionally the model file to rig (default: example_tira.glb in RIG_INPUT_HOST).
# RIG_MAC_ROOT=/path/to/rig-engine-mac/root
# RIG_MAC_WEIGHTS=/path/to/rig-engine-mac/weights/skintokens
# RIG_MAC_INPUT=/path/to/model.glb
